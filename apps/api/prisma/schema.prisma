generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HEAD_NURSE
  COORDINATOR
  NURSE
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  DISABLED
}

enum ClientPlatform {
  MINI_PROGRAM
  H5
  ADMIN_WEB
}

enum ActivationPurpose {
  ACTIVATE_ACCOUNT
  RESET_PASSWORD
}

enum NoticeLevel {
  NORMAL
  IMPORTANT
  URGENT
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  WITHDRAWN
  CANCELLED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  CLOSED
  WITHDRAWN
  CANCELLED
}

enum TaskCompletionMode {
  SIMPLE
  REVIEW
}

enum TaskRecordStatus {
  PENDING
  SUBMITTED
  RETURNED
  APPROVED
  COMPLETED
  EXCLUDED
}

enum SubmissionReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

enum ReminderTargetType {
  NOTICE_RECIPIENT
  TASK_RECORD
}

enum ReminderChannel {
  IN_APP
  WECHAT_SUBSCRIBE
  MANUAL
}

enum ReminderStatus {
  PLANNED
  PROCESSING
  SENT
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCELLED
}

enum FileStatus {
  PENDING
  READY
  BLOCKED
  DELETED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum ExportType {
  NOTICE_RECIPIENTS
  TASK_RECORDS
}

enum ExportStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(128)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users      User[]
  groups     NursingGroup[]
  notices    Notice[]
  tasks      Task[]
  reminders  Reminder[]
  auditLogs  AuditLog[]
  exportJobs ExportJob[]

  @@map("departments")
}

model NursingGroup {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(64)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users      User[]

  @@unique([departmentId, code])
  @@unique([departmentId, name])
  @@index([departmentId, enabled])
  @@map("nursing_groups")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  departmentId      String     @db.Uuid
  primaryGroupId    String?    @db.Uuid
  employeeNo        String     @unique @db.VarChar(64)
  name              String     @db.VarChar(64)
  role              UserRole
  status            UserStatus @default(PENDING_ACTIVATION)
  passwordHash      String?    @db.VarChar(255)
  passwordChangedAt DateTime?  @db.Timestamptz(3)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz(3)
  activatedAt       DateTime?  @db.Timestamptz(3)
  disabledAt        DateTime?  @db.Timestamptz(3)
  disabledReason    String?    @db.VarChar(255)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  department               Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  primaryGroup             NursingGroup?       @relation(fields: [primaryGroupId], references: [id], onDelete: SetNull)
  activationCodes          ActivationCode[]    @relation("ActivationCodeUser")
  issuedActivationCodes    ActivationCode[]    @relation("ActivationCodeIssuer")
  wechatIdentities         WechatIdentity[]
  refreshSessions          RefreshSession[]
  permissions              UserPermission[]    @relation("PermissionUser")
  grantedPermissions       UserPermission[]    @relation("PermissionGrantor")
  createdNotices           Notice[]            @relation("NoticeCreator")
  publishedNotices         Notice[]            @relation("NoticePublisher")
  createdNoticeVersions    NoticeVersion[]     @relation("NoticeVersionCreator")
  noticeRecipients         NoticeRecipient[]   @relation("NoticeRecipientUser")
  excludedNoticeRecipients NoticeRecipient[]   @relation("NoticeRecipientExcluder")
  createdTasks             Task[]              @relation("TaskCreator")
  publishedTasks           Task[]              @relation("TaskPublisher")
  taskRecords              TaskRecord[]        @relation("TaskAssignee")
  excludedTaskRecords      TaskRecord[]        @relation("TaskRecordExcluder")
  reviewedSubmissions      TaskSubmission[]    @relation("SubmissionReviewer")
  uploadedFiles            FileObject[]        @relation("FileUploader")
  receivedReminders        Reminder[]          @relation("ReminderRecipient")
  requestedReminders       Reminder[]          @relation("ReminderRequester")
  auditLogs                AuditLog[]          @relation("AuditActor")
  idempotencyRecords       IdempotencyRecord[]
  requestedExports         ExportJob[]         @relation("ExportRequester")

  @@index([departmentId, status])
  @@index([departmentId, role])
  @@index([primaryGroupId])
  @@map("users")
}

model ActivationCode {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  purpose       ActivationPurpose
  codeHash      String            @db.VarChar(255)
  expiresAt     DateTime          @db.Timestamptz(3)
  usedAt        DateTime?         @db.Timestamptz(3)
  invalidatedAt DateTime?         @db.Timestamptz(3)
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  user      User @relation("ActivationCodeUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("ActivationCodeIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@map("activation_codes")
}

model WechatIdentity {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  appId     String    @db.VarChar(64)
  openId    String    @db.VarChar(128)
  unionId   String?   @db.VarChar(128)
  boundAt   DateTime  @default(now()) @db.Timestamptz(3)
  unboundAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([appId, openId])
  @@unique([userId, appId])
  @@index([unionId])
  @@map("wechat_identities")
}

model RefreshSession {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  platform     ClientPlatform
  tokenHash    String         @unique @db.VarChar(255)
  deviceId     String?        @db.VarChar(128)
  userAgent    String?        @db.VarChar(512)
  ipAddress    String?        @db.VarChar(64)
  expiresAt    DateTime       @db.Timestamptz(3)
  lastUsedAt   DateTime?      @db.Timestamptz(3)
  revokedAt    DateTime?      @db.Timestamptz(3)
  revokeReason String?        @db.VarChar(128)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Permission {
  code        String @id @db.VarChar(64)
  name        String @db.VarChar(64)
  description String @db.VarChar(255)

  users UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId         String   @db.Uuid
  permissionCode String   @db.VarChar(64)
  grantedById    String   @db.Uuid
  grantedAt      DateTime @default(now()) @db.Timestamptz(3)

  user       User       @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  grantedBy  User       @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, permissionCode])
  @@index([permissionCode])
  @@map("user_permissions")
}

model Notice {
  id                   String       @id @default(uuid()) @db.Uuid
  departmentId         String       @db.Uuid
  title                String       @db.VarChar(200)
  level                NoticeLevel
  status               NoticeStatus @default(DRAFT)
  currentVersion       Int          @default(0)
  requiresConfirmation Boolean      @default(true)
  deadline             DateTime?    @db.Timestamptz(3)
  recipientSelection   Json?
  createdById          String       @db.Uuid
  publishedById        String?      @db.Uuid
  publishedAt          DateTime?    @db.Timestamptz(3)
  closedAt             DateTime?    @db.Timestamptz(3)
  closeReason          String?      @db.VarChar(255)
  withdrawnAt          DateTime?    @db.Timestamptz(3)
  withdrawReason       String?      @db.VarChar(255)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  department  Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?             @relation("NoticePublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  versions    NoticeVersion[]
  recipients  NoticeRecipient[]

  @@index([departmentId, status, publishedAt])
  @@index([departmentId, deadline])
  @@map("notices")
}

model NoticeVersion {
  id                String      @id @default(uuid()) @db.Uuid
  noticeId          String      @db.Uuid
  versionNo         Int
  title             String      @db.VarChar(200)
  content           String      @db.Text
  level             NoticeLevel
  deadline          DateTime?   @db.Timestamptz(3)
  reconfirmRequired Boolean     @default(false)
  changeReason      String?     @db.VarChar(255)
  createdById       String      @db.Uuid
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  notice        Notice                    @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation("NoticeVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  views         NoticeView[]
  confirmations NoticeConfirmation[]
  attachments   NoticeVersionAttachment[]

  @@unique([noticeId, versionNo])
  @@index([noticeId, createdAt])
  @@map("notice_versions")
}

model NoticeRecipient {
  id              String    @id @default(uuid()) @db.Uuid
  noticeId        String    @db.Uuid
  userId          String    @db.Uuid
  addedVersionNo  Int
  addedAt         DateTime  @default(now()) @db.Timestamptz(3)
  excludedAt      DateTime? @db.Timestamptz(3)
  excludedById    String?   @db.Uuid
  exclusionReason String?   @db.VarChar(255)

  notice        Notice               @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  user          User                 @relation("NoticeRecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  excludedBy    User?                @relation("NoticeRecipientExcluder", fields: [excludedById], references: [id], onDelete: Restrict)
  views         NoticeView[]
  confirmations NoticeConfirmation[]
  reminders     Reminder[]

  @@unique([noticeId, userId])
  @@index([userId, excludedAt])
  @@map("notice_recipients")
}

model NoticeView {
  id              String   @id @default(uuid()) @db.Uuid
  recipientId     String   @db.Uuid
  noticeVersionId String   @db.Uuid
  viewedAt        DateTime @default(now()) @db.Timestamptz(3)

  recipient NoticeRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  version   NoticeVersion   @relation(fields: [noticeVersionId], references: [id], onDelete: Restrict)

  @@unique([recipientId, noticeVersionId])
  @@map("notice_views")
}

model NoticeConfirmation {
  id              String   @id @default(uuid()) @db.Uuid
  recipientId     String   @db.Uuid
  noticeVersionId String   @db.Uuid
  confirmedAt     DateTime @default(now()) @db.Timestamptz(3)

  recipient NoticeRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  version   NoticeVersion   @relation(fields: [noticeVersionId], references: [id], onDelete: Restrict)

  @@unique([recipientId, noticeVersionId])
  @@map("notice_confirmations")
}

model Task {
  id                 String             @id @default(uuid()) @db.Uuid
  departmentId       String             @db.Uuid
  title              String             @db.VarChar(200)
  content            String             @db.Text
  level              NoticeLevel
  status             TaskStatus         @default(DRAFT)
  completionMode     TaskCompletionMode
  feedbackRequired   Boolean            @default(false)
  attachmentRequired Boolean            @default(false)
  deadline           DateTime           @db.Timestamptz(3)
  assigneeSelection  Json?
  createdById        String             @db.Uuid
  publishedById      String?            @db.Uuid
  publishedAt        DateTime?          @db.Timestamptz(3)
  closedAt           DateTime?          @db.Timestamptz(3)
  closeReason        String?            @db.VarChar(255)
  withdrawnAt        DateTime?          @db.Timestamptz(3)
  withdrawReason     String?            @db.VarChar(255)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  department  Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?            @relation("TaskPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  records     TaskRecord[]
  attachments TaskAttachment[]

  @@index([departmentId, status, publishedAt])
  @@index([departmentId, deadline])
  @@map("tasks")
}

model TaskRecord {
  id              String           @id @default(uuid()) @db.Uuid
  taskId          String           @db.Uuid
  assigneeId      String           @db.Uuid
  status          TaskRecordStatus @default(PENDING)
  completedAt     DateTime?        @db.Timestamptz(3)
  excludedAt      DateTime?        @db.Timestamptz(3)
  excludedById    String?          @db.Uuid
  exclusionReason String?          @db.VarChar(255)
  lockVersion     Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  excludedBy  User?            @relation("TaskRecordExcluder", fields: [excludedById], references: [id], onDelete: Restrict)
  submissions TaskSubmission[]
  reminders   Reminder[]

  @@unique([taskId, assigneeId])
  @@index([assigneeId, status])
  @@map("task_records")
}

model TaskSubmission {
  id            String                 @id @default(uuid()) @db.Uuid
  taskRecordId  String                 @db.Uuid
  submissionNo  Int
  feedback      String?                @db.Text
  reviewStatus  SubmissionReviewStatus @default(PENDING)
  submittedAt   DateTime               @default(now()) @db.Timestamptz(3)
  reviewedById  String?                @db.Uuid
  reviewedAt    DateTime?              @db.Timestamptz(3)
  reviewComment String?                @db.Text

  taskRecord  TaskRecord                 @relation(fields: [taskRecordId], references: [id], onDelete: Restrict)
  reviewedBy  User?                      @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  attachments TaskSubmissionAttachment[]

  @@unique([taskRecordId, submissionNo])
  @@index([reviewStatus, submittedAt])
  @@map("task_submissions")
}

model FileObject {
  id           String     @id @default(uuid()) @db.Uuid
  storageKey   String     @unique @db.VarChar(512)
  originalName String     @db.VarChar(255)
  mimeType     String     @db.VarChar(128)
  sizeBytes    BigInt
  sha256       String?    @db.VarChar(64)
  status       FileStatus @default(PENDING)
  uploadedById String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  readyAt      DateTime?  @db.Timestamptz(3)

  uploadedBy            User                       @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  noticeAttachments     NoticeVersionAttachment[]
  taskAttachments       TaskAttachment[]
  submissionAttachments TaskSubmissionAttachment[]
  exportJobs            ExportJob[]

  @@index([uploadedById, createdAt])
  @@map("file_objects")
}

model NoticeVersionAttachment {
  noticeVersionId String @db.Uuid
  fileId          String @db.Uuid
  sortOrder       Int    @default(0)

  noticeVersion NoticeVersion @relation(fields: [noticeVersionId], references: [id], onDelete: Restrict)
  file          FileObject    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([noticeVersionId, fileId])
  @@map("notice_version_attachments")
}

model TaskAttachment {
  taskId    String @db.Uuid
  fileId    String @db.Uuid
  sortOrder Int    @default(0)

  task Task       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([taskId, fileId])
  @@map("task_attachments")
}

model TaskSubmissionAttachment {
  taskSubmissionId String @db.Uuid
  fileId           String @db.Uuid
  sortOrder        Int    @default(0)

  submission TaskSubmission @relation(fields: [taskSubmissionId], references: [id], onDelete: Restrict)
  file       FileObject     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([taskSubmissionId, fileId])
  @@map("task_submission_attachments")
}

model Reminder {
  id                String             @id @default(uuid()) @db.Uuid
  departmentId      String             @db.Uuid
  targetType        ReminderTargetType
  noticeRecipientId String?            @db.Uuid
  taskRecordId      String?            @db.Uuid
  recipientId       String             @db.Uuid
  channel           ReminderChannel
  status            ReminderStatus     @default(PLANNED)
  scheduledAt       DateTime           @db.Timestamptz(3)
  sentAt            DateTime?          @db.Timestamptz(3)
  attemptCount      Int                @default(0)
  maxAttempts       Int                @default(3)
  requestedById     String?            @db.Uuid
  externalMessageId String?            @db.VarChar(255)
  errorCode         String?            @db.VarChar(64)
  errorMessage      String?            @db.VarChar(512)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  noticeRecipient NoticeRecipient? @relation(fields: [noticeRecipientId], references: [id], onDelete: Restrict)
  taskRecord      TaskRecord?      @relation(fields: [taskRecordId], references: [id], onDelete: Restrict)
  recipient       User             @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  requestedBy     User?            @relation("ReminderRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@index([recipientId, createdAt])
  @@index([noticeRecipientId])
  @@index([taskRecordId])
  @@map("reminders")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  departmentId String      @db.Uuid
  actorId      String?     @db.Uuid
  action       String      @db.VarChar(96)
  targetType   String      @db.VarChar(64)
  targetId     String?     @db.VarChar(64)
  result       AuditResult
  requestId    String?     @db.VarChar(64)
  ipAddress    String?     @db.VarChar(64)
  userAgent    String?     @db.VarChar(512)
  reason       String?     @db.VarChar(255)
  beforeData   Json?
  afterData    Json?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actor      User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([departmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model ExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  departmentId  String       @db.Uuid
  requestedById String       @db.Uuid
  type          ExportType
  status        ExportStatus @default(QUEUED)
  filters       Json
  outputFileId  String?      @db.Uuid
  errorMessage  String?      @db.VarChar(512)
  requestedAt   DateTime     @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?    @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)
  expiresAt     DateTime?    @db.Timestamptz(3)

  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requestedBy User        @relation("ExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  outputFile  FileObject? @relation(fields: [outputFileId], references: [id], onDelete: Restrict)

  @@index([departmentId, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([status, requestedAt])
  @@map("export_jobs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  idempotencyKey String   @db.VarChar(128)
  method         String   @db.VarChar(8)
  path           String   @db.VarChar(255)
  requestHash    String   @db.VarChar(64)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey, method, path])
  @@index([expiresAt])
  @@map("idempotency_records")
}
