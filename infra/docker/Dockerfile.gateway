FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/client/package.json apps/client/package.json
COPY apps/admin-web/package.json apps/admin-web/package.json
RUN pnpm install --frozen-lockfile --filter @hzy/client... --filter @hzy/admin-web...
COPY apps/client apps/client
COPY apps/admin-web apps/admin-web
RUN pnpm --filter @hzy/client build:h5 \
    && pnpm --filter @hzy/client build:mp-weixin \
    && pnpm --filter @hzy/admin-web build

FROM nginx:alpine
COPY infra/nginx/nursemate.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/client/dist/build/h5 /usr/share/nginx/html
COPY --from=build /workspace/apps/admin-web/dist /usr/share/nginx/html/admin
EXPOSE 80
