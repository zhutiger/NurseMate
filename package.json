{
  "name": "hzy-nursemate",
  "version": "0.1.0",
  "private": true,
  "description": "呼吸通护理重要消息与任务闭环管理平台",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.22.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:openapi": "pnpm --filter @hzy/api check:openapi",
    "prisma:format": "pnpm --filter @hzy/api prisma:format",
    "prisma:validate": "pnpm --filter @hzy/api prisma:validate"
  }
}

